{
  "name": "mini-apps",
  "version": "1.0.0",
  "description": "A collection of single-page apps hosted with Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "css:build": "tailwindcss -i styles/tailwind.css -o public/shared/tailwind.css --minify",
    "build": "npm run css:build && node build.js",
    "test": "node --test"
  },
  "dependencies": {
    "connect-livereload": "^0.6.1",
    "express": "^4.18.2",
    "livereload": "^0.9.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "tailwindcss": "^3.4.17"
  }
}
